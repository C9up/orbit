{
  "name": "@c9up/orbit",
  "version": "0.1.0",
  "description": "Orbit — aurora components as native views on a phone, laid out and diffed by a Rust host",
  "license": "MIT",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./react-native": {
      "types": "./src/react-native/index.ts",
      "import": "./src/react-native/index.ts"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "test:rust": "cargo test --manifest-path crates/orbit-host/Cargo.toml",
    "lint": "biome check src/ tests/",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit -p ."
  },
  "peerDependencies": {
    "@c9up/aurora": "^0.1.53"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.12",
    "@c9up/aurora": "^0.1.53",
    "@vitest/coverage-v8": "4.1.11",
    "typescript": "^6.0.3",
    "vitest": "4.1.11"
  },
  "files": [
    "src",
    "dist",
    "specs",
    "scripts",
    "Cargo.toml",
    "Cargo.lock",
    "crates/orbit-host/src",
    "crates/orbit-host/Cargo.toml",
    "android/orbit.cmake",
    "android/src",
    "README.md",
    "LICENSE"
  ],
  "reamNative": {
    "specs": "specs",
    "rust": [
      {
        "manifest": "crates/orbit-host/Cargo.toml",
        "lib": "orbit_host"
      }
    ],
    "android": {
      "java": "android/src/main/java",
      "cmake": {
        "file": "android/orbit.cmake",
        "link": "orbit_link"
      },
      "cxxModules": [
        {
          "name": "NativeOrbit",
          "header": "NativeOrbit.h"
        }
      ]
    }
  },
  "publishConfig": {
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      },
      "./react-native": {
        "types": "./dist/react-native/index.d.ts",
        "import": "./dist/react-native/index.js"
      }
    },
    "access": "public"
  }
}
